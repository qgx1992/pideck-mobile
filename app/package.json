    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/status-bar": "^7.0.6",
    "@pierre/diffs": "1.4.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-virtual": "^3.14.22",
    "ai": "^7.0.48",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
