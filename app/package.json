{
  "name": "pideck-mobile",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "description": "PiDeck 手机客户端（Capacitor 壳 + 上游 web 界面）",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cap:sync": "npm run build && cap sync",
    "apk:release": "node scripts/build-apk.mjs --release",
    "test": "node --test shell/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "apk": "node scripts/build-apk.mjs",
    "publish:apk": "node scripts/publish-apk.mjs",
    "smoke": "node scripts/smoke-ui.mjs"
  },
