{
  "name": "pideck-mobile-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PiDeck 手机客户端外壳（Vite + TypeScript + Capacitor）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json",
    "cap:sync": "npm run build && cap sync",
    "cap:add:android": "cap add android",
    "cap:open:android": "cap open android",
    "cap:run:android": "npm run build && cap run android",
    "test": "node --test \"tests/*.test.ts\"",
    "apk": "node scripts/build-apk.mjs",
    "publish:apk": "node scripts/publish-apk.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "verify:send": "node scripts/verify-send.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/status-bar": "^7.0.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.0",
    "vite": "^6.0.0"
  }
}
