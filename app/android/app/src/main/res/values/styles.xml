<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/appBackgroundDark</item>
        <item name="android:navigationBarColor">@color/appBackgroundDark</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- 底部导航栏初值：深色背景 + 浅色图标（与默认深色主题一致），运行时由 NavigationBar 插件覆盖 -->
        <item name="android:windowLightNavigationBar">false</item>
        <!--
          targetSdk 35 (Android 15) 会强制 edge-to-edge：状态栏变透明、内容顶到屏幕最上方，
          setStatusBarColor 失效，而图标颜色仍跟系统浅色主题走 → 深色界面上出现深色图标（看不见）。
          这里显式退出强制 edge-to-edge，恢复「状态栏是不透明色条」的传统行为，
          由 @capacitor/status-bar 控制背景色与图标明暗。
          注意：该属性在 Android 16 起会被移除，届时应改为完整适配 edge-to-edge + insets。
        -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>


    <!--
      Flutter 宿主页的专属主题：这里是**真 edge-to-edge**。
      WebView 那边为了状态栏可控退出了强制 edge-to-edge（见 AppTheme.NoActionBar），
      但 Flutter 页自己会画到状态栏/手势条底下，还要让两条栏透明才能真正"跟着主题变"，
      否则会看到 AppTheme.NoActionBar 里那条固定深灰的状态栏色带（0.2.1 的实测截图）。
    -->
    <style name="AppTheme.FlutterHost" parent="AppTheme.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- 首帧前的一瞬间：用深色兜底，避免闪白 -->
        <item name="android:windowBackground">@color/appBackgroundDark</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>