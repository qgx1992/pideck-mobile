<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/appBackgroundDark</item>
        <item name="android:navigationBarColor">@color/appBackgroundDark</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- 底部导航栏初值：深色背景 + 浅色图标（与默认深色主题一致），运行时由 NavigationBar 插件覆盖 -->
        <item name="android:windowLightNavigationBar">false</item>
        <!--
          targetSdk 35 (Android 15) 会强制 edge-to-edge：状态栏变透明、内容顶到屏幕最上方，
          setStatusBarColor 失效，而图标颜色仍跟系统浅色主题走 → 深色界面上出现深色图标（看不见）。
          这里显式退出强制 edge-to-edge，恢复「状态栏是不透明色条」的传统行为，
          由 @capacitor/status-bar 控制背景色与图标明暗。
          注意：该属性在 Android 16 起会被移除，届时应改为完整适配 edge-to-edge + insets。
        -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>


    <!--
      桌面网页版（DesktopWebActivity）的专属主题：这里是**真 edge-to-edge**。
      Capacitor 那边的 AppTheme.NoActionBar 为了状态栏可控退出了强制 edge-to-edge，
      但桌面网页版要画到状态栏/手势条底下，两条栏必须透明，图标明暗由运行时
      `DesktopWebActivity.applyBarTheme()` 按页面主题切换（写死深色会在浅色主题下变成白底白图标）。
    -->
    <!--
      桌面网页版（DesktopWebActivity）的专属主题：**不让内容进系统栏**。

      0.3.0/0.3.1 走的是真 edge-to-edge（两条栏透明、页面画到栏底下），靠页面自己的
      `env(safe-area-inset-*)` 让位。但裸 WebView 里那个 env 恒为 0，0.3.1 改成原生加
      padding 兜住 —— 仍然是「内容铺到栏底下、只是不画在那里」，状态栏那一带的点击照样
      被系统吃掉（用户的实际感受就是「顶进去就点不到」）。

      所以这里回到传统的 decor-fit：系统把内容排在状态栏下面，栏是不透明色条，
      颜色由运行时 `applyBarTheme()` 按页面底色实时同步（视觉上仍是接在一起的深/浅色）。
      Android 16 起 windowOptOutEdgeToEdgeEnforcement 会被移除，那时由
      DesktopWebActivity 里的 insets 监听兜住，不会又顶回去。
    -->
    <style name="AppTheme.WebShell" parent="AppTheme.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:statusBarColor">@color/appBackgroundDark</item>
        <item name="android:navigationBarColor">@color/appBackgroundDark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- 首帧前的一瞬间：用深色兜底，避免闪白 -->
        <item name="android:windowBackground">@color/appBackgroundDark</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>