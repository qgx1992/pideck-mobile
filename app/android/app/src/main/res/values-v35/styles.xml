<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 15 (API 35) 专用覆盖：
  targetSdk 35 起系统强制 edge-to-edge，statusBarColor 被忽略、图标明暗只跟系统主题。
  加上 windowOptOutEdgeToEdgeEnforcement 可退出强制 edge-to-edge，恢复可控的状态栏。
  同时把状态栏与导航栏都设为不透明背景，避免内容顶到刘海区。
-->
<resources>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:statusBarColor">@color/appBackgroundDark</item>
        <item name="android:navigationBarColor">@color/appBackgroundDark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <!--
      API 35 起系统强制 edge-to-edge —— Flutter 宿主页正好要的就是这个行为，
      所以这里不再退出强制，只把两条栏设透明并把图标明暗交给 SystemChrome。
    -->
    <style name="AppTheme.FlutterHost" parent="AppTheme.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/appBackgroundDark</item>
    </style>
</resources>
