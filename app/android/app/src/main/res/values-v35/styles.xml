<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 15 (API 35) 专用覆盖：
  targetSdk 35 起系统强制 edge-to-edge，statusBarColor 被忽略、图标明暗只跟系统主题。
  加上 windowOptOutEdgeToEdgeEnforcement 可退出强制 edge-to-edge，恢复可控的状态栏。
  同时把状态栏与导航栏都设为不透明背景，避免内容顶到刘海区。
-->
<resources>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:statusBarColor">@color/appBackgroundDark</item>
        <item name="android:navigationBarColor">@color/appBackgroundDark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <!--
      API 35 起系统默认强制 edge-to-edge：内容会画到状态栏底下。桌面网页版不要这个行为 ——
      裸 WebView 里 `env(safe-area-inset-*)` 恒为 0，侧边栏顶栏会顶进状态栏且点不到。
      这里退出强制（windowOptOutEdgeToEdgeEnforcement=true），由系统把内容排在状态栏下面，
      两条栏用页面底色（运行时 `applyBarTheme()` 实时同步）保持视觉连续。
    -->
    <style name="AppTheme.WebShell" parent="AppTheme.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:statusBarColor">@color/appBackgroundDark</item>
        <item name="android:navigationBarColor">@color/appBackgroundDark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/appBackgroundDark</item>
    </style>
</resources>
