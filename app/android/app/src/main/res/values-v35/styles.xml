<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 15 (API 35) 专用覆盖：
  targetSdk 35 起系统强制 edge-to-edge，statusBarColor 被忽略、图标明暗只跟系统主题。
  加上 windowOptOutEdgeToEdgeEnforcement 可退出强制 edge-to-edge，恢复可控的状态栏。
  同时把状态栏与导航栏都设为不透明背景，避免内容顶到刘海区。
-->
<resources>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:statusBarColor">@color/appBackgroundDark</item>
        <item name="android:navigationBarColor">@color/appBackgroundDark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
