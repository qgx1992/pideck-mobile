node_modules/
*.log
.env
.DS_Store

# build artifacts (APK not for VCS)
apk/

# 调试临时文件
*.tmp.json
# 旧壳调试用的根目录转储（只限根目录，别误伤 test/resources 里的 fixtures）
/st*.json

# Python 缓存（gen-icon.py / gen-splash.py）
__pycache__/
*.pyc

# 原生 Android 工程（C 方案）：构建产物与本机 SDK 路径不入库
native/**/build/
native/.gradle/
native/local.properties
native/.kotlin/
native/.idea/
native/**/*.iml

# 原生工程的签名配置（如有，也不入库）
native/keystore.properties
native/*.keystore
