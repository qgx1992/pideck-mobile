build/
# .android/ 里的 gradle 接线文件必须提交（settings.gradle 依赖 include_flutter.groovy），
# 只忽略机器相关的 local.properties 与构建产物
.android/*
!.android/gradle/
!.android/settings.gradle
!.android/build.gradle
!.android/gradle.properties
!.android/gradlew
!.android/gradlew.bat
!.android/include_flutter.groovy
!.android/Flutter/
!.android/app/
.android/local.properties
.android/.gradle/
.android/**/build/
# NDK/C++ 中间产物（编过 native 就会出现，几百个文件）
.android/**/.cxx/
.ios/
.flutter-plugins-dependencies

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json
